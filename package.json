{
  "name": "mental-clinic",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n backend,admin,frontend -c blue,magenta,green \"pnpm:dev:backend\" \"pnpm:dev:admin\" \"pnpm:dev:frontend\"",
    "dev:backend": "pnpm --filter @mental-clinic/backend start",
    "dev:admin": "pnpm --filter @mental-clinic/admin start --port 4201",
    "dev:frontend": "pnpm --filter @mental-clinic/frontend start --port 4200",
    "build": "pnpm -r --if-present build",
    "build:admin": "pnpm --filter @mental-clinic/admin build",
    "build:frontend": "pnpm --filter @mental-clinic/frontend build",
    "build:sites": "pnpm --filter \"./apps/personal-websites/*\" build",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "packageExtensions": {
      "@ngx-env/builder@18": {
        "peerDependencies": {
          "@angular-devkit/architect": "*"
        }
      }
    }
  }
}
