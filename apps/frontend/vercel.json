{
  "outputDirectory": "dist/mental-clinic-fe/browser",
  "ignoreCommand": "git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}^{commit}\" 2>/dev/null && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../pnpm-lock.yaml || exit 1",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/test",
      "destination": "/test/list",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tests",
      "destination": "/test/list",
      "permanent": true
    },
    {
      "source": "/tests/:path*",
      "destination": "/test/list/:path*",
      "permanent": true
    },
    {
      "source": "/doctor-skripnik.com.ua/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/kk",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/kk/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/mental-clinic-fe/server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "index,follow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
